# .env.example

# Nome do projeto (usado no nome dos containers Docker)
COMPOSE_PROJECT_NAME=mundo_logistica_front


# Porta do site (deixe vazio para o Makefile preencher automaticamente)
PORTA_SITE=

# ============================================================================
# Endpoint da API de Catálogo de Cursos
# ============================================================================
# URL completa do endpoint JSON de cursos (Ex: https://api.mundologistica.com.br/courses.php)
# Se vazio, usa http://localhost:8080/courses.php localmente ou /api/courses.php em produção
NEXT_PUBLIC_COURSES_API_URL=

# ============================================================================
# Configuração de Envio de E-mail do Formulário de Leads (Next.js /api/lead)
# ============================================================================
# E-mail que receberá as solicitações de proposta comercial:
LEAD_TO_EMAIL=comercial@mundologistica.com.br

# Credenciais SMTP para disparo (Ex: Hostinger, Gmail, Amazon SES):
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

